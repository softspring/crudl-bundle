{
    "name": "softspring/crudl-bundle",
    "description": "A CRUD+list helper bundle.",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "softspring/components": "^6.0@dev",
        "softspring/crudl-controller": "^6.0@dev",
        "softspring/dynamic-form-type": "^6.0@dev",
        "symfony/http-kernel": "^8.0.5",
        "symfony/dependency-injection": "^6.4|^7.3"
    },
    "require-dev": {
        "doctrine/orm": "^2.5 | ^3.0",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpmd/phpmd": "dev-master",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\CrudlBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\CrudlBundle\\Tests\\": "tests/"
        }
    }
}
