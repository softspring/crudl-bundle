{
    "name": "softspring/crudl-bundle",
    "description": "A CRUD+list helper bundle.",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "softspring/components": "^5.3",
        "softspring/crudl-controller": "^5.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.64.*",
        "phpmd/phpmd": "dev-master",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5.5",
        "symfony/http-kernel": "^5.4|^6.0|^7.0",
        "symfony/dependency-injection": "^5.4|^6.0|^7.0",
        "rector/rector": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\CrudlBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\CrudlBundle\\Tests\\": "tests/"
        }
    }
}
